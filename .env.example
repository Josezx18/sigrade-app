# Database
DATABASE_URL="postgresql://sigrade:sigrade_dev@localhost:5432/sigrade?schema=public"
POSTGRES_USER=sigrade
POSTGRES_PASSWORD=sigrade_dev
POSTGRES_DB=sigrade

# Runtime connection (NON-OWNER role) — subject to Row Level Security.
# The `sigrade_app` role is created by prisma/apply-rls.sql with CRUD grants.
# Required so multi-tenant isolation is actually enforced (owners bypass RLS).
# Migrations/seed keep using DATABASE_URL (owner, which bypasses RLS on purpose).
APP_DATABASE_URL="postgresql://sigrade_app:sigrade_app_dev@localhost:5432/sigrade?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-random-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-another-random-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="sigrade"
MINIO_SECRET_KEY="sigrade_dev"
MINIO_ROOT_USER=sigrade
MINIO_ROOT_PASSWORD=sigrade_dev
MINIO_BUCKET_EVIDENCES="sigrade-evidences"
MINIO_BUCKET_DOCUMENTS="sigrade-documents"
MINIO_BUCKET_AVATARS="sigrade-avatars"
MINIO_USE_SSL="false"

# API
API_PORT=3000
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:4200"

# Frontend
VITE_API_URL="http://localhost:3000/api/v1"
VITE_WS_URL="ws://localhost:3000"

# AI Provider (default: nvidia)
AI_PROVIDER="nvidia"

# NVIDIA NIM (OpenAI-compatible, free tier en https://build.nvidia.com)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-4-maverick"

# OpenAI (alternative to NVIDIA, set AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@sigrade.gob.do"

# Logging
LOG_LEVEL="debug"
LOG_FORMAT="pretty"
NODE_ENV="development"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Feature Flags
FEATURE_AI_PLANNING="true"
FEATURE_AI_GRADING="true"
FEATURE_AI_PREDICTIVE="true"
FEATURE_REALTIME="true"
